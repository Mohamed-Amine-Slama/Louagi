# Copy to terraform.tfvars (gitignored). Auth via: export CLOUDFLARE_API_TOKEN=...
account_id         = "0123456789abcdef0123456789abcdef"
zone_id            = "0123456789abcdef0123456789abcdef"
api_hostname       = "api.louagi.com"
admin_api_hostname = "admin-api.louagi.com"

# Same value as GATEWAY_SECRET in server/.env (openssl rand -hex 32)
gateway_secret = "..."

# Recommended: lock the admin API to office/VPN IPs; without it the admin host is
# as open as the mobile one. Point the dashboard's server-side API_URL at
# api_hostname (its BFF calls carry no admin token) so Vercel's dynamic egress
# IPs don't need allowlisting.
# admin_allowed_ips = ["203.0.113.0/24"]

# Pro plan or higher: turn on the Managed + OWASP rulesets (default false for Free)
# managed_waf = true
