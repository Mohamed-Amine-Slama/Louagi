  "cards": [
    { "dot": "cyan", "title": "Clients", "items": [
      "Mobile app: public, passenger and driver stacks; ar / en / fr i18n",
      "Web export of the app is served from Vercel (vercel.json SPA fallback)",
      "EXPO_PUBLIC_USE_MOCKS=true swaps the API for an in-memory mock",
      "Admin dashboard: browser holds the access token in memory; /api/auth/* BFF keeps the refresh token in an httpOnly cookie; browser GraphQL calls use the admin API hostname"
    ] },
    { "dot": "violet", "title": "Edge (Cloudflare)", "items": [
      "NGFW = WAF phases, which run before Workers: custom rules allow only POST/OPTIONS /graphql and GET/HEAD /health, an optional admin IP allowlist, a per-IP rate limit, and the Cloudflare Managed Ruleset",
      "No CDN: a cache rule bypasses caching on both API hostnames",
      "API gateway Worker serves only the admin hostname: it passes POST/OPTIONS /graphql and stamps x-louagi-gateway",
      "The Tunnel is outbound-only, so the origin has no public IP or open port"
    ] },
    { "dot": "emerald", "title": "Backend", "items": [
      "Single protocol: POST /graphql with operationName → command or query bus",
      "Event bus feeds a cache-invalidation projection that drops stale Redis keys",
      "Redis is optional: after 10 failed retries the API falls back to the DB",
      "Every 5 min the API calls cleanup_expired_seat_locks()"
    ] },
    { "dot": "rose", "title": "Security", "items": [
      "Self-issued JWT access + refresh tokens; OTP via SMS / email; admin TOTP",
      "Bus auth middleware plus RBAC checks in handlers; driver PII field-encrypted",
      "Admin tokens are honored only on gateway-stamped requests (GATEWAY_SECRET)",
      "Production rejects plain HTTP and privileged Postgres users"
    ] },
    { "dot": "amber", "title": "Deploy & local", "items": [
      "Terraform (Cloudflare provider): ngfw, edge, api_gateway modules",
      "infra/docker-compose.yml runs api + redis + cloudflared in production",
      "Repo-root docker-compose runs api + Expo app + redis for local dev"
    ] }
  ]
